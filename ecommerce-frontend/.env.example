# FastAPI URL used by the Vite development server proxy.
API_PROXY_TARGET=URL_OF_YOUR_FASTAPI_SERVER

# Optional absolute API base URL for a deployed frontend. Leave unset to use /api.
# VITE_API_BASE_URL=

# Optional absolute WebSocket endpoint for a deployed frontend. Leave unset to use /ws.
# VITE_WS_BASE_URL=

# Optional public API documentation URL. Defaults to the local backend docs or
# the /docs path on VITE_API_BASE_URL when it is an absolute URL.
# VITE_API_DOCS_URL=http://127.0.0.1:8000/docs

# Optional public storefront formatting preferences.
# VITE_LOCALE=en-IN
# VITE_CURRENCY=INR
